<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <RelativeLayout android:layout_width="match_parent" android:layout_height="64dp">
   <ImageView android:id="@+id/logo" android:layout_width="54dp" android:layout_height="54dp" android:src="@drawable/radio_logo" android:layout_centerVertical="true"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAINEL" android:textColor="@color/gold" android:textStyle="bold" android:textSize="22sp" android:layout_centerInParent="true"/>
   <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="@color/white" android:textSize="14sp" android:padding="12dp" android:background="@drawable/bg_button" android:layout_alignParentRight="true" android:layout_centerVertical="true"/>
  </RelativeLayout>
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● VERIFICANDO SINAL..." android:textColor="@color/gold" android:textStyle="bold" android:textSize="16sp" android:gravity="center" android:padding="14dp" android:background="@drawable/bg_card" android:layout_marginTop="8dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
   <TextView android:id="@+id/listeners" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:text="OUVINTES\n--" android:textColor="@color/white" android:gravity="center" android:textSize="15sp" android:background="@drawable/bg_card"/>
   <Space android:layout_width="8dp" android:layout_height="1dp"/>
   <TextView android:id="@+id/bitrate" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:text="BITRATE\n--" android:textColor="@color/white" android:gravity="center" android:textSize="15sp" android:background="@drawable/bg_card"/>
  </LinearLayout>
  <TextView android:id="@+id/now" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TOCANDO AGORA\n--" android:textColor="@color/white" android:textSize="16sp" android:padding="18dp" android:background="@drawable/bg_card" android:layout_marginTop="12dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONTROLE DA TRANSMISSÃO" android:textColor="@color/gold" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="18dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
   <Button android:id="@+id/start" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="▶ INICIAR" android:textColor="@color/white" android:background="@drawable/bg_button"/>
   <Space android:layout_width="8dp" android:layout_height="1dp"/>
   <Button android:id="@+id/stop" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="■ PARAR" android:textColor="@color/white" android:background="@drawable/bg_button"/>
  </LinearLayout>
  <Button android:id="@+id/automation" android:layout_width="match_parent" android:layout_height="52dp" android:text="⚙ MOTOR DE AUTOMAÇÃO: DESLIGADO" android:textColor="@color/white" android:background="@drawable/bg_button" android:layout_marginTop="8dp"/>
  <Button android:id="@+id/reconnect" android:layout_width="match_parent" android:layout_height="52dp" android:text="↻ ATUALIZAR / RECONECTAR" android:textColor="@color/white" android:background="@drawable/bg_button" android:layout_marginTop="8dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PROGRAMAÇÃO" android:textColor="@color/gold" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="18dp"/>
  <Button android:id="@+id/hour" android:layout_width="match_parent" android:layout_height="52dp" android:text="⏰ HORA CERTA" android:textColor="@color/white" android:background="@drawable/bg_button" android:layout_marginTop="8dp"/>
  <Button android:id="@+id/calls" android:layout_width="match_parent" android:layout_height="52dp" android:text="📢 CHAMADAS DE PROGRAMAS" android:textColor="@color/white" android:background="@drawable/bg_button" android:layout_marginTop="8dp"/>
  <Button android:id="@+id/grade" android:layout_width="match_parent" android:layout_height="52dp" android:text="📅 GRADE DE PROGRAMAÇÃO" android:textColor="@color/white" android:background="@drawable/bg_button" android:layout_marginTop="8dp"/>
  <Button android:id="@+id/library" android:layout_width="match_parent" android:layout_height="52dp" android:text="🎵 PASTA DE ÁUDIOS" android:textColor="@color/white" android:background="@drawable/bg_button" android:layout_marginTop="8dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONTEÚDO" android:textColor="@color/gold" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="18dp"/>
  <Button android:id="@+id/word" android:layout_width="match_parent" android:layout_height="52dp" android:text="📖 PALAVRA DO DIA" android:textColor="@color/white" android:background="@drawable/bg_button" android:layout_marginTop="8dp"/>
  <Button android:id="@+id/devotional" android:layout_width="match_parent" android:layout_height="52dp" android:text="🙏 DEVOCIONAL" android:textColor="@color/white" android:background="@drawable/bg_button" android:layout_marginTop="8dp"/>
  <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Painel pronto." android:textColor="@color/muted" android:textSize="12sp" android:padding="12dp" android:layout_marginTop="14dp"/>
 </LinearLayout>
</ScrollView>
