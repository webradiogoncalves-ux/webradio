<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="#05080F" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/logo" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/radio_logo" android:contentDescription="Logo" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WEB RÁDIO" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vem Comigo no Glória" android:textColor="#FFD12A" android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_card" android:padding="12dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center">
                <ImageView android:id="@+id/radioImage" android:layout_width="190dp" android:layout_height="190dp" android:src="@drawable/radio_logo" android:scaleType="centerCrop" android:contentDescription="Rádio" />
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● DESLIGADA" android:textColor="#AFC0D6" android:textSize="14sp" android:gravity="center"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Web Rádio Vem Comigo no Glória" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" android:gravity="center" android:paddingTop="4dp"/>
            <TextView android:id="@+id/nowPlaying" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transmissão ao vivo" android:textColor="#AFC0D6" android:textSize="14sp" android:gravity="center" android:paddingTop="3dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center" android:paddingTop="5dp">
                <Button android:id="@+id/volumeDown" android:layout_width="55dp" android:layout_height="48dp" android:text="−" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/bg_button"/>
                <Button android:id="@+id/play" android:layout_width="100dp" android:layout_height="50dp" android:text="▶" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/bg_primary" android:layout_marginLeft="10dp" android:layout_marginRight="10dp"/>
                <Button android:id="@+id/volumeUp" android:layout_width="55dp" android:layout_height="48dp" android:text="+" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/bg_button"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:padding="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⏰  HORA CERTA" android:textColor="#FFD12A" android:textSize="16sp" android:textStyle="bold"/>
            <Switch android:id="@+id/hourSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.72" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/bible" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="📖\nBÍBLIA SAGRADA" android:textColor="#FFFFFF" android:textSize="15sp" android:background="@drawable/bg_button" android:layout_marginRight="4dp"/>
            <Button android:id="@+id/devotional" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🙏\nDEVOCIONAL" android:textColor="#FFFFFF" android:textSize="15sp" android:background="@drawable/bg_button" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"/>
            <Button android:id="@+id/word" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="💬\nPALAVRA\nDO DIA" android:textColor="#FFFFFF" android:textSize="15sp" android:background="@drawable/bg_button" android:layout_marginLeft="4dp"/>
        </LinearLayout>

        <Button android:id="@+id/share" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="COMPARTILHAR RÁDIO" android:textColor="#FFFFFF" android:textSize="15sp" android:background="@drawable/bg_primary"/>
    </LinearLayout>
</LinearLayout>
