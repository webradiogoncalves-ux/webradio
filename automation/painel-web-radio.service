[Unit]
Description=Motor de Automação Web Rádio Vem Comigo no Glória
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/painel-web-radio
EnvironmentFile=/opt/painel-web-radio/automation/.env
ExecStart=/usr/bin/python3 /opt/painel-web-radio/automation/engine.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
